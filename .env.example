# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL for this deployment (used for links / OAuth).
APP_URL="https://vote.blackowl.id/headoffice"

# BASE_PATH: URL mount path for this app under the shared vote domain.
BASE_PATH="/headoffice"

# PORT: Internal Node listen port (nginx proxies here).
PORT=3001
